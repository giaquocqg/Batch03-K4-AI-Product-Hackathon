# Primary provider; when both keys exist, the other provider is the backup.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# Required before protected course data may be sent to configured providers.
# Read both providers' current policies when both keys are configured.
EXTERNAL_AI_DATA_POLICY_CONFIRMED=false

# Required for any non-loopback/public bind. Use a random value of 24+ chars.
APP_ACCESS_TOKEN=replace-with-a-long-random-access-token

# Optional outside the repository; defaults to the local authorized corpus.
STUDY_PACK_DATA_ROOT=D:/private/study-pack-corpus/transcript
